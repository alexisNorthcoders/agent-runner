{
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "module": "nodenext",
    "target": "es2024",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "bin/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "scripts/jsdoc"
  ]
}
