# agent-runner configuration. Copy to .env; every value is optional.

# Command API port, bound to 127.0.0.1 only (the bot's AGENT_RUNNER_URL points here).
# AGENT_RUNNER_PORT=3790
# PM2 app name that safe-restart restarts.
# AGENT_RUNNER_PM2_NAME=agent-runner

# Redis holds the run lock, pause flag and the agent-runner:outbox stream.
# REDIS_URL=redis://127.0.0.1:6379

# Working directory for freeform `claude <instructions>` runs.
# AGENT_WORKSPACE=/home/alexis/Projects
# Kill a run after this long (default 20 minutes).
# AGENT_TIMEOUT_MS=1200000

# Claude backend. Full path to the CLI if it isn't found on PATH (`which claude`).
# CLAUDE_AGENT_BIN=/home/alexis/.local/bin/claude
# Model alias or id, pinned so runs don't follow the interactive CLI default.
# CLAUDE_AGENT_MODEL=sonnet

# --- Issue runs (`claude issue:<alias>:<n>`). Names match the bot's, so its lines carry over. ---
# Allowlisted workspaces: alias=/abs/path pairs, and/or a JSON file {"alias": "/abs/path"} (wins).
# CLAUDE_WORKSPACE_MAP=bot=/home/alexis/Projects/WhatsappBot,platformer=/home/alexis/Projects/Platformer-Game
# CLAUDE_WORKSPACE_MAP_FILE=
# Workspace for `claude issue:<n>` with no alias.
# CLAUDE_ISSUE_DEFAULT_ALIAS=bot
# GitHub repo per alias, when the workspace's origin isn't a GitHub URL.
# CLAUDE_ISSUE_REPO_MAP=bot=alexisNorthcoders/WhatsappBot
# CLAUDE_ISSUE_BRANCH_PREFIX=claude/issue
# GH_BIN=/usr/bin/gh

# Post-run steps, all on by default; set to 0 to turn one off.
# CLAUDE_POST_RUN=1                  # everything after the agent
# CLAUDE_POST_RUN_PUSH=1
# CLAUDE_POST_RUN_PR=1
# CLAUDE_POST_RUN_AUTOFIX=1          # one agent pass after VERDICT: REQUEST_CHANGES
# CLAUDE_POST_RUN_PR_AUTO_MERGE=1
# CLAUDE_POST_RUN_PR_STALE_HEAD_SYNC=1
# CLAUDE_POST_RUN_LOG=1              # [issuePipeline] lines in the PM2 log
# Timeouts and polling.
# CLAUDE_POST_RUN_EXEC_TIMEOUT_MS=90000
# CLAUDE_POST_RUN_POLL_MS=250
# CLAUDE_POST_RUN_MAX_WAIT_MS=8000
# CLAUDE_POST_RUN_MERGEABLE_POLL_MS=2000
# CLAUDE_POST_RUN_MERGEABLE_MAX_WAIT_MS=90000
# CLAUDE_POST_RUN_ISSUE_CLOSE_POLL_MS=4000
# CLAUDE_POST_RUN_ISSUE_CLOSE_MAX_WAIT_MS=1800000

# PR review (OpenAI). Without a key the review is skipped, and nothing is auto-merged.
# OPENAI_API_KEY=
# CLAUDE_REVIEW_MODEL=gpt-5.4-mini
# CLAUDE_REVIEW_FALLBACK_MODEL=gpt-5.4-nano
# CLAUDE_REVIEW_MAX_TOKENS=2500
# CLAUDE_REVIEW_DIFF_MAX_CHARS=100000

# Summary email once the issue closes: DeepInfra writes it, Gmail sends it.
# DEEPINFRA_API_KEY=
# CLAUDE_POST_CLOSE_CHANGES_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# GMAIL_EMAIL=
# GMAIL_PASSWORD=
# CLAUDE_REVIEW_EMAIL_TO=
# CLAUDE_REVIEW_EMAIL_SUBJECT_PREFIX=

# `claude joplin:<note>` reads from the Joplin Data API (desktop app Web Clipper service, or
# `joplin server start` for the terminal app). Token: Options → Web Clipper → Authorization token,
# or `joplin config api.token`.
# JOPLIN_API_URL=http://127.0.0.1:41184
# JOPLIN_API_TOKEN=
# Only notes in this notebook can be used as prompts.
# JOPLIN_AGENT_NOTEBOOK=WhatsApp Bot
