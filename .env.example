# agent-runner configuration. Copy to .env; every value is optional.

# Command API port, bound to 127.0.0.1 only (the bot's AGENT_RUNNER_URL points here).
# AGENT_RUNNER_PORT=3790
# PM2 app name that safe-restart restarts.
# AGENT_RUNNER_PM2_NAME=agent-runner

# Redis holds the run lock, pause flag and the agent-runner:outbox stream.
# REDIS_URL=redis://127.0.0.1:6379

# Working directory for freeform `claude <instructions>` runs.
# AGENT_WORKSPACE=/home/alexis/Projects
# Kill a run after this long (default 20 minutes).
# AGENT_TIMEOUT_MS=1200000

# Claude backend. Full path to the CLI if it isn't found on PATH (`which claude`).
# CLAUDE_AGENT_BIN=/home/alexis/.local/bin/claude
# Model alias or id, pinned so runs don't follow the interactive CLI default.
# CLAUDE_AGENT_MODEL=sonnet

# `claude joplin:<note>` reads from the Joplin Data API (desktop app Web Clipper service, or
# `joplin server start` for the terminal app). Token: Options → Web Clipper → Authorization token,
# or `joplin config api.token`.
# JOPLIN_API_URL=http://127.0.0.1:41184
# JOPLIN_API_TOKEN=
# Only notes in this notebook can be used as prompts.
# JOPLIN_AGENT_NOTEBOOK=WhatsApp Bot
