{
  "name": "agent-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone PM2 service that runs headless coding-agent sessions and reports through a Redis outbox",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "node --no-deprecation src/main.js",
    "test": "node --test 'test/**/*.test.js'",
    "typecheck": "tsc -p jsconfig.json",
    "safe-restart": "node bin/safe-restart.js",
    "agent:status": "node bin/agent-cli.js status",
    "agent:watch": "node bin/agent-cli.js watch",
    "agent:history": "node bin/agent-cli.js history",
    "agent:logs": "node bin/agent-cli.js logs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.6.1",
    "nodemailer": "^10.0.10",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2"
  }
}
